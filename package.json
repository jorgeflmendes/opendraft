{
  "name": "opendraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first LaTeX workspace for writing, compiling, and reviewing scientific documents in the browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgeflmendes/opendraft.git"
  },
  "homepage": "https://github.com/jorgeflmendes/opendraft#readme",
  "bugs": {
    "url": "https://github.com/jorgeflmendes/opendraft/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "npm run build && playwright test --project=chromium --grep-invert @heavy",
    "assets:og": "node scripts/generate-og-image.mjs",
    "setup:engine": "node scripts/setup-engine.mjs",
    "setup:engine:swift": "node scripts/setup-engine.mjs --swift-only",
    "security:audit": "npm audit --audit-level=moderate",
    "hygiene": "python check_repository.py",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run hygiene && npm run security:audit && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "texlyre-busytex": "^1.1.1",
    "xz-decompress": "^0.2.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
